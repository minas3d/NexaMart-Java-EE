<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <!-- ==================== Database Config ==================== -->
   

    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:postgresql://localhost:5432/nexamart_db</param-value>
    </context-param>

    <context-param>
        <param-name>db.username</param-name>
        <param-value>postgres</param-value>
    </context-param>

    <context-param>
        <param-name>db.password</param-name>
        <param-value>postgres123</param-value>
    </context-param>
    
     <context-param>
    <param-name>db.driverClassName</param-name>
    <param-value>org.postgresql.Driver</param-value>
	</context-param>

    <context-param>
        <param-name>db.pool.maximumPoolSize</param-name>
        <param-value>10</param-value>
    </context-param>

    <context-param>
        <param-name>db.pool.minimumIdle</param-name>
        <param-value>2</param-value>
    </context-param>

    <context-param>
        <param-name>db.pool.connectionTimeout</param-name>
        <param-value>30000</param-value>
    </context-param>

    <context-param>
        <param-name>db.pool.idleTimeout</param-name>
        <param-value>600000</param-value>
    </context-param>

    <context-param>
        <param-name>db.pool.maxLifetime</param-name>
        <param-value>1800000</param-value>
    </context-param>

    <context-param>
        <param-name>db.pool.poolName</param-name>
        <param-value>EcommercePool</param-value>
    </context-param>
    
        <!-- ==================== Filters ==================== -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>nti.filters.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>nti.filters.LoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>nti.filters.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/dashboard</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/orders</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/profile</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/edit-profile</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/checkout</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/order-confirmation</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>nti.filters.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

        <!-- ==================== Servlet: Register ==================== -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>nti.servlets.auth.RegisterServlet</servlet-class>

        <multipart-config>
            <max-file-size>2097152</max-file-size>          <!-- 2 MB per file -->
            <max-request-size>5242880</max-request-size>    <!-- 5 MB total -->
            <file-size-threshold>0</file-size-threshold>    <!-- write to disk immediately -->
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Login ==================== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>nti.servlets.auth.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Logout ==================== -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>nti.servlets.auth.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Forgot Password ==================== -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>nti.servlets.auth.ForgotPasswordServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Reset Password ==================== -->
    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>nti.servlets.auth.ResetPasswordServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>
        <!-- ==================== Servlet: Browse ==================== -->
    <servlet>
        <servlet-name>BrowseServlet</servlet-name>
        <servlet-class>nti.servlets.customer.BrowseServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BrowseServlet</servlet-name>
        <url-pattern>/browse</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Product Details ==================== -->
    <servlet>
        <servlet-name>ProductDetailsServlet</servlet-name>
        <servlet-class>nti.servlets.customer.ProductDetailsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProductDetailsServlet</servlet-name>
        <url-pattern>/product-details</url-pattern>
    </servlet-mapping>
    
    
        <!-- ==================== Servlet: Cart ==================== -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>nti.servlets.customer.CartServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Add To Cart ==================== -->
    <servlet>
        <servlet-name>AddToCartServlet</servlet-name>
        <servlet-class>nti.servlets.customer.AddToCartServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddToCartServlet</servlet-name>
        <url-pattern>/add-to-cart</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Home ==================== -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>nti.servlets.common.HomeServlet</servlet-class>
    </servlet>

    <!-- ==================== Servlet: Customer Dashboard ==================== -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>nti.servlets.customer.DashboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/customer/dashboard</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Image ==================== -->
    <servlet>
        <servlet-name>ImageServlet</servlet-name>
        <servlet-class>nti.servlets.common.ImageServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ImageServlet</servlet-name>
        <url-pattern>/image</url-pattern>
    </servlet-mapping>
    
    
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
    
    
        <!-- ==================== Servlet: Checkout ==================== -->
    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>nti.servlets.customer.CheckoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Order Confirmation ==================== -->
    <servlet>
        <servlet-name>OrderConfirmationServlet</servlet-name>
        <servlet-class>nti.servlets.customer.OrderConfirmationServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>OrderConfirmationServlet</servlet-name>
        <url-pattern>/order-confirmation</url-pattern>
    </servlet-mapping>
    
        <!-- ==================== Servlet: Order List ==================== -->
    <servlet>
        <servlet-name>OrderListServlet</servlet-name>
        <servlet-class>nti.servlets.customer.OrderListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>OrderListServlet</servlet-name>
        <url-pattern>/customer/orders</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Customer Order Details ==================== -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>nti.servlets.customer.OrderServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/customer/order-view</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Search ==================== -->
    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>nti.servlets.customer.SearchServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Customer Profile ==================== -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>nti.servlets.customer.ProfileServlet</servlet-class>

        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>3145728</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/customer/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/customer/edit-profile</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Admin Dashboard ==================== -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>nti.servlets.admin.AdminDashboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Admin Products ==================== -->
    <servlet>
        <servlet-name>AdminProductServlet</servlet-name>
        <servlet-class>nti.servlets.admin.AdminProductServlet</servlet-class>

        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminProductServlet</servlet-name>
        <url-pattern>/admin/products</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Admin Categories ==================== -->
    <servlet>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <servlet-class>nti.servlets.admin.AdminCategoryServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <url-pattern>/admin/categories</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Admin Orders ==================== -->
    <servlet>
        <servlet-name>AdminOrderServlet</servlet-name>
        <servlet-class>nti.servlets.admin.AdminOrderServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminOrderServlet</servlet-name>
        <url-pattern>/admin/orders</url-pattern>
    </servlet-mapping>

        <!-- ==================== Servlet: Admin Customers ==================== -->
    <servlet>
        <servlet-name>AdminCustomerServlet</servlet-name>
        <servlet-class>nti.servlets.admin.AdminCustomerServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminCustomerServlet</servlet-name>
        <url-pattern>/admin/customers</url-pattern>
    </servlet-mapping>

        <!-- ==================== Error Page ==================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

        <!-- ==================== Listeners ==================== -->
    <listener>
    <listener-class>nti.listeners.AppContextListener</listener-class>
	</listener>
    
 </web-app>
    